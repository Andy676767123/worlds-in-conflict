:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #edf6ff;
  background: #09111d;
  color-scheme: dark;
  line-height: 1.5;
  font-weight: 400;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(96, 165, 250, 0.18), transparent 35%),
    #09111d;
}

body {
  min-height: 100vh;
}

button {
  border: none;
  border-radius: 12px;
  padding: 0.76rem 1rem;
  background: rgba(255,255,255,0.08);
  color: white;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
  opacity: 0.98;
}

button.accent {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
}

.app-shell {
  max-width: 1480px;
  margin: 0 auto;
  padding: 1.25rem;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.eyebrow {
  margin: 0;
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #7dd3fc;
}

h1 {
  margin: 0.3rem 0 0;
  font-size: clamp(2rem, 3vw, 3rem);
}

.toolbar {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.layout {
  display: grid;
  grid-template-columns: minmax(0, 2.2fr) minmax(320px, 1fr);
  gap: 1rem;
}

.world-panel,
.card {
  background: rgba(15,23,42,0.82);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 22px;
  box-shadow: 0 18px 45px rgba(15, 23, 42, 0.38);
}

.world-panel {
  padding: 1rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.stat {
  background: rgba(255,255,255,0.04);
  border-radius: 14px;
  padding: 0.85rem 0.9rem;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.stat span {
  font-size: 0.7rem;
  color: #a5b4cf;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.stat strong {
  font-size: 1.28rem;
}

.map {
  position: relative;
  height: 720px;
  overflow: hidden;
  border-radius: 22px;
  background:
    linear-gradient(rgba(14, 116, 144, 0.12), rgba(2, 6, 23, 0.2)),
    linear-gradient(135deg, #071d2b, #10263a 45%, #0d1a2b);
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.map-lines {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.nation {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 86px;
  min-height: 72px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: white;
  font-weight: 700;
  border: 3px solid rgba(255,255,255,0.35);
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.45);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}

.nation:hover {
  transform: translate(-50%, -50%) scale(1.05);
}

.nation.selected {
  box-shadow: 0 0 0 4px rgba(255,255,255,0.16), 0 14px 35px rgba(59,130,246,0.5);
  border-color: rgba(255,255,255,0.8);
}

.nation span {
  font-size: 0.62rem;
  text-shadow: 0 2px 8px rgba(0,0,0,0.35);
}

.nation small {
  font-size: 0.88rem;
}

.sidebar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.card {
  padding: 1rem;
}

.card h2,
.card h3 {
  margin-top: 0;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.7rem;
  margin: 1rem 0;
}

.metrics > div {
  background: rgba(255,255,255,0.04);
  border-radius: 14px;
  padding: 0.72rem 0.8rem;
}

.metrics > div.wide {
  grid-column: 1 / -1;
}

.metrics span {
  display: block;
  color: #a5b4cf;
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.metrics strong {
  font-size: 1.08rem;
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.7rem;
}

.full {
  grid-column: 1 / -1;
}

.log {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.log li {
  background: rgba(255,255,255,0.04);
  border-radius: 12px;
  padding: 0.7rem 0.8rem;
  color: #dbeafe;
  font-size: 0.94rem;
}

.summary-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.summary-list p {
  margin: 0;
  background: rgba(255,255,255,0.04);
  border-radius: 12px;
  padding: 0.7rem 0.8rem;
}

@media (max-width: 980px) {
  .layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .actions {
    grid-template-columns: 1fr;
  }

  .map {
    height: 560px;
  }
}
